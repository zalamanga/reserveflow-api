{
  "info": {"name": "ReserveFlow REST API", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json", "description": "Synthetic local demo. Import the blank environment, fill keys privately, then run in order. Do not export filled secrets."},
  "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{alphaApiKey}}", "type": "string"}]},
  "variable": [{"key": "runId", "value": ""}, {"key": "productId", "value": "0"}, {"key": "reservationId", "value": "0"}],
  "item": [
    {"name": "01 Health", "request": {"method": "GET", "auth": {"type": "noauth"}, "url": "{{baseUrl}}/healthz"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Database ready', () => pm.response.to.have.status(200));"]}}]},
    {"name": "02 Create one-unit product", "request": {"method": "POST", "url": "{{baseUrl}}/v1/products", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"sku\":\"PM-{{runId}}\",\"name\":\"Synthetic Postman stock\",\"onHand\":1}", "options": {"raw": {"language": "json"}}}}, "event": [{"listen": "prerequest", "script": {"exec": ["pm.collectionVariables.set('runId', pm.variables.replaceIn('{{$guid}}').replace(/-/g, '').toUpperCase());"]}}, {"listen": "test", "script": {"exec": ["pm.test('Created', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) pm.collectionVariables.set('productId', String(pm.response.json().id));"]}}]},
    {"name": "03 Reserve the unit", "request": {"method": "POST", "url": "{{baseUrl}}/v1/reservations", "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Idempotency-Key", "value": "hold-{{runId}}"}], "body": {"mode": "raw", "raw": "{\"productId\":{{productId}},\"quantity\":1,\"ttlSeconds\":300}", "options": {"raw": {"language": "json"}}}}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Hold created', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) { pm.collectionVariables.set('reservationId', String(pm.response.json().id)); pm.collectionVariables.set('holdBody', pm.response.text()); }"]}}]},
    {"name": "04 Replay identical request", "request": {"method": "POST", "url": "{{baseUrl}}/v1/reservations", "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Idempotency-Key", "value": "hold-{{runId}}"}], "body": {"mode": "raw", "raw": "{\"productId\":{{productId}},\"quantity\":1,\"ttlSeconds\":300}", "options": {"raw": {"language": "json"}}}}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Stable replay', () => { pm.response.to.have.status(201); pm.expect(pm.response.headers.get('Idempotency-Replayed')).to.eql('true'); pm.expect(pm.response.text()).to.eql(pm.collectionVariables.get('holdBody')); });"]}}]},
    {"name": "05 Different key finds no available stock", "request": {"method": "POST", "url": "{{baseUrl}}/v1/reservations", "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Idempotency-Key", "value": "other-{{runId}}"}], "body": {"mode": "raw", "raw": "{\"productId\":{{productId}},\"quantity\":1,\"ttlSeconds\":300}", "options": {"raw": {"language": "json"}}}}, "event": [{"listen": "test", "script": {"exec": ["pm.test('No oversell', () => pm.response.to.have.status(409));"]}}]},
    {"name": "06 Beta cannot read Alpha hold", "request": {"method": "GET", "url": "{{baseUrl}}/v1/reservations/{{reservationId}}", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{betaApiKey}}", "type": "string"}]}}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Tenant isolation', () => pm.response.to.have.status(404));"]}}]},
    {"name": "07 Confirm", "request": {"method": "POST", "url": "{{baseUrl}}/v1/reservations/{{reservationId}}/confirm", "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Idempotency-Key", "value": "confirm-{{runId}}"}], "body": {"mode": "raw", "raw": "{}", "options": {"raw": {"language": "json"}}}}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Confirmed', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().state).to.eql('confirmed'); });"]}}]},
    {"name": "08 Inspect consumed stock", "request": {"method": "GET", "url": "{{baseUrl}}/v1/products/{{productId}}"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Stock consumed once', () => { pm.response.to.have.status(200); const p = pm.response.json(); pm.expect(p.onHand).to.eql(0); pm.expect(p.reserved).to.eql(0); pm.expect(p.available).to.eql(0); });"]}}]},
    {"name": "09 List audit", "request": {"method": "GET", "url": "{{baseUrl}}/v1/audit?limit=20"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Audit page', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().items).to.be.an('array'); });"]}}]},
    {"name": "10 OpenAPI contract", "request": {"method": "GET", "auth": {"type": "noauth"}, "url": "{{baseUrl}}/openapi.json"}}
  ]
}
